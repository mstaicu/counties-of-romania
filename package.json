{
  "name": "counties-of-romania",
  "version": "2.1.0",
  "description": "Romanian counties",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": "https://github.com/mstaicu/counties-of-romania",
  "author": "Mircea Staicu",
  "license": "MIT",
  "keywords": [
    "romania",
    "counties"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test src/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
